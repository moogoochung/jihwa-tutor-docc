할 약속","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import ARKit","import simd","","\/\/ …","","@MainActor","protocol HandFeed: AnyObject {","    var samples: AsyncStream<HandSample> { get }","    func start() async","    func stop()","}"],"syntax":"swift","showLineNumbers":false,"lineAnnotations":[{"style":"highlight","range":[{"line":6},{"line":6}]},{"style":"highlight","range":[{"line":7},{"line":7}]},{"range":[{"line":8},{"line":8}],"style":"highlight"},{"range":[{"line":9},{"line":9}],"style":"highlight"},{"range":[{"line":10},{"line":10}],"style":"highlight"},{"range":[{"line":11},{"line":11}],"style":"highlight"}],"wrap":0,"copyToClipboard":true},{"text":"1.2","anchor":"12","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"한 프레임 분량의 손 정보를 "},{"code":"HandSample","type":"codeVoice"},{"type":"text","text":"로 정의합니다. 실기기 경로와 가짜 경로가 "},{"inlineContent":[{"type":"text","text":"같은 타입"}],"type":"strong"},{"type":"text","text":"을 내보내는 것이 핵심입니다. 나중에 진짜 손을 붙일 때 뒷단을 하나도 고치지 않아도 됩니다."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"HandSample.swift","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — 한 프레임의 손"}]},{"syntax":"swift","code":["import ARKit","import simd","","\/\/\/ 판정 단계로 넘어가는 한 프레임 분량의 손 정보.","\/\/\/ 실기기 경로와 목 데이터 경로가 같은 타입을 낸다.","struct HandSample {","    var feature: PoseFeature","    var chirality: HandAnchor.Chirality","    \/\/\/ 오버레이 정렬용. 목 데이터에서는 nil.","    var wristTransform: simd_float4x4?","    \/\/\/ 손목에서 중지 너클까지의 거리. 오버레이 크기 보정에 쓴다.","    var handSpan: Float","    var timestamp: TimeInterval","}"],"showLineNumbers":false,"type":"codeListing","wrap":0,"copyToClipboard":true,"lineAnnotations":[{"range":[{"line":4},{"line":4}],"style":"highlight"},{"range":[{"line":5},{"line":5}],"style":"highlight"},{"range":[{"line":6},{"line":6}],"style":"highlight"},{"range":[{"line":7},{"line":7}],"style":"highlight"},{"range":[{"line":8},{"line":8}],"style":"highlight"},{"range":[{"line":9},{"line":9}],"style":"highlight"},{"range":[{"line":10},{"line":10}],"style":"highlight"},{"range":[{"line":11},{"line":11}],"style":"highlight"},{"range":[{"line":12},{"line":12}],"style":"highlight"},{"range":[{"line":13},{"line":13}],"style":"highlight"},{"style":"highlight","range":[{"line":14},{"line":14}]}]},{"text":"1.3","anchor":"13","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"먼저 다룰 자모 40자를 정의합니다. 한국수화사전(2005) 기준으로 자음 19자, 모음 21자입니다."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"code":"Jamo.swift","type":"codeVoice"}]},{"text":" — 자음 19 · 모음 21","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","\/\/\/ 한글 지문자 자모. 한국수화사전(2005) 기준 자음 19자 · 모음 21자 = 40자.","enum Jamo: String, CaseIterable, Identifiable, Sendable {","    \/\/ 자음 19","    case giyeok = \"ㄱ\", ssangGiyeok = \"ㄲ\", nieun = \"ㄴ\", digeut = \"ㄷ\", ssangDigeut = \"ㄸ\"","    case rieul = \"ㄹ\", mieum = \"ㅁ\", bieup = \"ㅂ\", ssangBieup = \"ㅃ\", siot = \"ㅅ\"","    case ssangSiot = \"ㅆ\", ieung = \"ㅇ\", jieut = \"ㅈ\", ssangJieut = \"ㅉ\", chieut = \"ㅊ\"","    case kieuk = \"ㅋ\", tieut = \"ㅌ\", pieup = \"ㅍ\", hieut = \"ㅎ\"","","    \/\/ 모음 21","    case a = \"ㅏ\", ae = \"ㅐ\", ya = \"ㅑ\", yae = \"ㅒ\", eo = \"ㅓ\", e = \"ㅔ\", yeo = \"ㅕ\", ye = \"ㅖ\"","    case o = \"ㅗ\", wa = \"ㅘ\", wae = \"ㅙ\", oe = \"ㅚ\", yo = \"ㅛ\"","    case u = \"ㅜ\", weo = \"ㅝ\", we = \"ㅞ\", wi = \"ㅟ\", yu = \"ㅠ\"","    case eu = \"ㅡ\", ui = \"ㅢ\", i = \"ㅣ\"","    \/\/ …","}"],"type":"codeListing","showLineNumbers":false,"wrap":0,"copyToClipboard":true,"lineAnnotations":[{"style":"highlight","range":[{"line":3},{"line":3}]},{"style":"highlight","range":[{"line":4},{"line":4}]},{"style":"highlight","range":[{"line":5},{"line":5}]},{"range":[{"line":6},{"line":6}],"style":"highlight"},{"range":[{"line":7},{"line":7}],"style":"highlight"},{"range":[{"line":8},{"line":8}],"style":"highlight"},{"range":[{"line":9},{"line":9}],"style":"highlight"},{"style":"highlight","range":[{"line":10},{"line":10}]},{"style":"highlight","range":[{"line":11},{"line":11}]},{"range":[{"line":12},{"line":12}],"style":"highlight"},{"range":[{"line":13},{"line":13}],"style":"highlight"},{"style":"highlight","range":[{"line":14},{"line":14}]},{"range":[{"line":15},{"line":15}],"style":"highlight"}]},{"anchor":"14","type":"heading","text":"1.4","level":3},{"inlineContent":[{"type":"text","text":"가짜 손은 기준 포즈 주위에서 미세하게 떨리는 값을 90Hz로 내보냅니다. 중지 관절 하나에는 일부러 오차를 실어 둡니다. 나중에 채점이 이 오차를 잡아내는지 확인하는 데 씁니다."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"code":"MockHandFeed.swift","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — 떨리는 가짜 손 한 프레임"}],"type":"paragraph"},{"lineAnnotations":[{"range":[{"line":10},{"line":10}],"style":"highlight"},{"range":[{"line":11},{"line":11}],"style":"highlight"},{"range":[{"line":12},{"line":12}],"style":"highlight"},{"range":[{"line":13},{"line":13}],"style":"highlight"},{"range":[{"line":14},{"line":14}],"style":"highlight"},{"range":[{"line":15},{"line":15}],"style":"highlight"},{"range":[{"line":16},{"line":16}],"style":"highlight"},{"range":[{"line":17},{"line":17}],"style":"highlight"},{"range":[{"line":18},{"line":18}],"style":"highlight"},{"range":[{"line":19},{"line":19}],"style":"highlight"},{"range":[{"line":20},{"line":20}],"style":"highlight"},{"range":[{"line":21},{"line":21}],"style":"highlight"},{"range":[{"line":22},{"line":22}],"style":"highlight"},{"range":[{"line":23},{"line":23}],"style":"highlight"}],"showLineNumbers":false,"code":["import ARKit","import Foundation","import QuartzCore","import simd","","@MainActor","final class MockHandFeed: HandFeed {","    \/\/ …","","    \/\/\/ 중지 하나에 오차를 싣고, 나머지는 사람 손 떨림 수준으로만 흔든다.","    private func perturb(_ base: PoseFeature, phase: Float) -> HandSample {","        var bend = base.bend","        let jitter: Float = 0.02","        for i in bend.indices { bend[i] += sin(phase + Float(i)) * jitter }","        if bend.count > 6 { bend[7] += injectedError }   \/\/ 중지 중간 관절","","        let f = PoseFeature(bend: bend, spread: base.spread, palmNormal: base.palmNormal)","        return HandSample(feature: f,","                          chirality: .right,","                          wristTransform: nil,","                          handSpan: 0.09,","                          timestamp: CACurrentMediaTime())","    }","}"],"type":"codeListing","copyToClipboard":true,"syntax":"swift","wrap":0},{"level":3,"type":"heading","text":"1.5","anchor":"15"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"그 프레임을 90Hz로 흘려보냅니다.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":"에 계속 밀어 넣는 루프가 전부입니다. 굽힘각 15개가 화면에 흐르면 1단계 성공입니다 — 이 숫자가 이후 모든 계산의 원재료입니다.","type":"text"}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"MockHandFeed.swift"}]},{"text":" — 90Hz 재생 루프","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","showLineNumbers":false,"lineAnnotations":[{"range":[{"line":10},{"line":10}],"style":"highlight"},{"range":[{"line":11},{"line":11}],"style":"highlight"},{"range":[{"line":12},{"line":12}],"style":"highlight"},{"range":[{"line":13},{"line":13}],"style":"highlight"},{"range":[{"line":14},{"line":14}],"style":"highlight"},{"range":[{"line":15},{"line":15}],"style":"highlight"},{"range":[{"line":16},{"line":16}],"style":"highlight"},{"range":[{"line":17},{"line":17}],"style":"highlight"},{"range":[{"line":18},{"line":18}],"style":"highlight"},{"range":[{"line":19},{"line":19}],"style":"highlight"},{"range":[{"line":20},{"line":20}],"style":"highlight"},{"range":[{"line":21},{"line":21}],"style":"highlight"},{"range":[{"line":22},{"line":22}],"style":"highlight"},{"style":"highlight","range":[{"line":23},{"line":23}]},{"range":[{"line":24},{"line":24}],"style":"highlight"},{"range":[{"line":25},{"line":25}],"style":"highlight"}],"copyToClipboard":true,"code":